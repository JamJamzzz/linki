# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Password to log in to the Linki UI
AUTH_PASSWORD=

# Internal secret for server-to-server API calls (e.g. the MCP server calling Linki's own
# /api/* routes over loopback). Generate with: openssl rand -base64 32
# Never sent to a browser or exposed externally — only Node processes on this host see it.
INTERNAL_API_SECRET=

# SQLite database path (optional — defaults to ./linki.db in cwd)
# When running via Docker, this is set automatically to /data/linki.db
LINKI_DB_PATH=

# Set to "false" to show the browser window during automation (useful for debugging)
HEADLESS=true

# Dropbox intake — watches a Dropbox folder for contact-import batches and turns each
# ready folder into a Linki list (+ optional workflow run). See docs/dropbox-intake.md.
# Disabled by default; the app runs normally with these unset or DROPBOX_INTAKE_ENABLED=false.
DROPBOX_INTAKE_ENABLED=false

# Dropbox app credentials (Settings > App Console on the Dropbox app you create).
# Use an "App folder" scoped app, not "Full Dropbox" — this confines DROPBOX_INTAKE_ROOT
# (and the LinkiProcessed/LinkiFailed archive folders) to that app's own sandboxed folder
# instead of the user's whole Dropbox.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Long-lived OAuth refresh token (not a short-lived access token — see docs/dropbox-intake.md
# for how to obtain one). Linki exchanges this for a fresh access token as needed.
DROPBOX_REFRESH_TOKEN=

# Root folder to monitor. Every direct child folder is one contact-import batch.
DROPBOX_INTAKE_ROOT=/LinkiInbox

# How often (seconds) the background runner checks the root folder for new/ready batches.
DROPBOX_INTAKE_POLL_INTERVAL_SECONDS=60

# Maximum contact rows accepted per contacts.csv — larger batches are rejected with an
# actionable error instead of being silently truncated.
DROPBOX_INTAKE_MAX_ROWS=500
